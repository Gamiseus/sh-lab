# ============================================================
# SH-LAB Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=sh_lab

# --- Security ---
# IMPORTANT: Change this to a random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- IGDB Metadata (Twitch Developer Console) ---
# Get credentials at: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Steam Integration (Optional) ---
# Can also be configured via the Admin Dashboard
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_WEB_API_KEY=

# --- Data Paths ---
GAMES_REPO_PATH=/data/repo
DATA_DIR=/data

# --- SteamCMD (auto-installed, usually no need to change) ---
# STEAMCMD_PATH=./steamcmd

# --- Development ---
# Set to "true" to log all SQL queries (noisy)
# SQL_ECHO=false

# --- Frontend (Vite) ---
# Set this if the backend is not on localhost:8000
# VITE_API_BASE=http://localhost:8000
